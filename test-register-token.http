### Test Push Token Registration

# 1. Register a test token
POST http://localhost:8080/api/push-token/register
Content-Type: application/json

{
  "token": "ExponentPushToken[test123456789abcdefghijklmnop]",
  "platform": "android",
  "deviceName": "Test Device",
  "appVersion": "1.0.0"
}

###

# 2. Check if token was registered
# (Cần admin token)
GET http://localhost:8080/api/push-tokens?page=1&limit=10
Authorization: Bearer YOUR_ADMIN_TOKEN_HERE

###

# 3. Send test notification (với secret key)
POST http://localhost:8080/api/notification/send
Content-Type: application/json

{
  "secretKey": "your-secret-key-from-env",
  "title": "Test Notification 🔔",
  "body": "Testing push notification system"
}

###

# 4. Send test notification (với admin token)
POST http://localhost:8080/api/push-notification/test
Content-Type: application/json
Authorization: Bearer YOUR_ADMIN_TOKEN_HERE

{
  "title": "Admin Test 🔔",
  "body": "Test từ admin panel"
}

